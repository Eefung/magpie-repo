# makepkg's working directories and the packages it produces are never committed
packages/*/src/
packages/*/pkg/
packages/*/*.pkg.tar.*
packages/*/magpie-*
packages/*/.srcdest/
# generated by build-check.sh from the PKGBUILD; nothing reads it from git
packages/*/.SRCINFO
*.pkg.tar.zst
*.pkg.tar.xz
__pycache__/
*.pyc
# the assembled pacman repository (built in CI, published on gh-pages)
repo/
